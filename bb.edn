{:paths ["src/bb"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str]
             [net.willcohen.native.build :as nb])

  :init (def cljs-suites
          (sort (map str (fs/glob "test" "{cljs,cljc}/**_test.cljc"))))

  lint:deps
  {:doc "Index the classpath into the clj-kondo cache, so lint resolves dependency vars. Run it again after a dependency bump."
   ;; --skip-lint leaves the cache empty. Not .cache: clojure-lsp writes it
   ;; and can stub a namespace there, which hides the real vars.
   ;; -A:build replaces the project deps, so build.clj needs its own classpath.
   :task (let [cp       (:out (shell {:out :string} "clojure" "-Spath"))
               build-cp (:out (shell {:out :string} "clojure" "-Spath" "-A:build"))]
           (shell "clj-kondo" "--lint" (str (str/trim cp) ":" (str/trim build-cp))
                  "--dependencies" "--parallel"
                  "--cache-dir" ".clj-kondo/.cache-cli"))}

  lint:js
  {:doc "Run eslint over the hand-written .mjs. eslint.config.mjs ignores the squint output."
   :depends [npm:install]
   :task (shell "npx" "eslint" ".")}

  lint
  {:doc "Run lint:js, then clj-kondo over src, test, build.clj, bb.edn, deps.edn and resources."
   :depends [lint:js]
   :task (do (when-not (fs/exists? ".clj-kondo/.cache-cli")
               (println "No clj-kondo dependency cache. Indexing the classpath once (see lint:deps).")
               (run 'lint:deps))
             (shell "clj-kondo" "--lint" "src" "test" "build.clj" "bb.edn" "deps.edn" "resources"
                    "--cache-dir" ".clj-kondo/.cache-cli"))}

  test:clj
  {:doc "Run the Clojure tests. test_runner_test.clj runs the compiled test_runner.mjs."
   :depends [build:js]
   :task (shell "clojure" "-M:test")}

  test:bb
  {:doc "Run the tests of the babashka build helpers in test/bb."
   :extra-paths ["test/bb"]
   :requires ([clojure.test :as t]
              [net.willcohen.native.build-test])
   :task (let [{:keys [fail error]} (t/run-tests 'net.willcohen.native.build-test)]
           (when (pos? (+ fail error)) (System/exit 1)))}

  test
  {:doc "Run every lane: test:clj, test:cljs and test:bb."
   :depends [test:clj test:cljs test:bb]}

  npm:install
  {:doc "Install the npm dependencies. package.json pins squint-cljs."
   :task (shell "npm" "install")}

  check:exports
  {:doc "Check the module inventory of net.willcohen.native.build against package.json.
Drift fails build:js, and through prepack each npm pack."
   :task (nb/check-exports-sync! "package.json")}

  build:js
  {:doc "Compile each shipped .cljc or .cljs module to the .mjs that npm ships."
   :depends [check:exports npm:install]
   :task (let [dir "src/cljc/net/willcohen/native"]
           (doseq [f nb/shipped-module-files
                   :let [base (str/replace f (re-pattern "\\.mjs$") "")
                         src  (first (filter (fn [src] (fs/exists? (fs/path dir src)))
                                             [(str base ".cljc") (str base ".cljs")]))]
                   :when src]
             (nb/squint-compile! dir src)))}

  build:js:test
  {:doc "Compile each cljs.test suite."
   :depends [npm:install]
   :task (doseq [f cljs-suites]
           (nb/squint-compile! (str (fs/parent f)) (str (fs/file-name f))))}

  test:cljs
  {:doc "Run the cljs.test suites on node. Each suite runs its tests on import."
   :depends [build:js build:js:test]
   ;; pool_test drives the FinalizationRegistry through gc().
   :task (doseq [f cljs-suites]
           (shell "node" "--expose-gc" (str (fs/strip-ext f) ".mjs")))}

  jar
  {:doc "Build the net.willcohen/native jar with tools.build."
   :task (shell "clojure" "-T:build" "jar")}

  install
  {:doc "Install the jar to ~/.m2, for a consumer to test with :mvn/version.
The local copy shadows the Clojars release, so it does not prove that
Clojars resolves."
   :depends [jar]
   :task (shell "clojure" "-X:deploy" ":installer" ":local")}

  deploy:clojars
  {:doc "Deploy the jar to Clojars. Needs CLOJARS_USERNAME and CLOJARS_PASSWORD (a deploy token)."
   :depends [jar]
   :task (shell "clojure" "-X:deploy")}

  deploy:npm
  {:doc "Publish ffi-wasm to npm. The prepack script runs bb build:js first."
   :task (shell "npm" "publish")}}}
