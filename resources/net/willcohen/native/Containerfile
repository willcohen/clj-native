# Containerfile (shipped with clj-native, extracted via io/resource)
#
# Consumers: do not check this in to your own repo. clj-native's
# cross-compile-in-container bb helper loads this from the classpath.
# If you need to customize (extra build stages, different base image),
# drop your own Containerfile at repo root and the helper will prefer it.
#
# Generic build/test/dev Nix-based environment. The stages encode a task
# vocabulary through overridable ARGs whose defaults match clj-native's
# consumer convention:
#   bb build --wasm; bb build --native --target <platform>;
#   bb test:ffi, test:graal, test:node, test:playwright;
#   flake outputs .#linuxAmd64Cross, .#linuxAarch64Cross,
#   .#windowsAmd64Cross, .#windowsArm64Cross (mkCrossShells provides
#   these); artifacts under resources/ and src/.
# A consumer whose bb.edn or flake diverges overrides the ARGs below, or
# drops its own Containerfile at repo root (the helper prefers it).
#
# Usage (via podman/docker directly):
#   podman build -f Containerfile --target native-build --platform linux/amd64 .
#   podman build -f Containerfile --target wasm-build .
#   podman build -f Containerfile --target test-all .
#   podman build -f Containerfile --target dev .
#   podman build -f Containerfile --target export --output type=local,dest=./artifacts .
#
# Extra args to bb inside the container:
#   --build-arg EXTRA_BB_ARGS="--local-source --debug"

FROM nixos/nix:latest AS base

# Pass-through extra args appended to bb build invocations.
# Consumers use this for flags like --local-source, --debug, etc.
ARG EXTRA_BB_ARGS=""
# Extra flags forwarded to every `nix develop` invocation. Used by
# clj-native's cross-compile-in-container helper to inject
# --override-input when a sibling flake has been vendored in.
ARG EXTRA_NIX_FLAGS=""

# Enable flakes and nix-command, disable syscall filtering, minimize disk.
RUN echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf && \
    echo "filter-syscalls = false" >> /etc/nix/nix.conf && \
    echo "auto-optimise-store = true" >> /etc/nix/nix.conf && \
    echo "min-free = 128000000" >> /etc/nix/nix.conf && \
    echo "max-free = 1000000000" >> /etc/nix/nix.conf

RUN git --version 2>/dev/null || nix-env -iA nixpkgs.git --option filter-syscalls false

ENV PATH=/nix/var/nix/profiles/default/bin:$PATH
ENV NIX_PATH=nixpkgs=/nix/var/nix/profiles/per-user/root/channels/nixpkgs

WORKDIR /build

# Copy the full build context so any vendored sibling flakes
# (clj-native-vendor/, etc.) are present before we warm the nix cache.
COPY . .

# If clj-native was auto-vendored, expose it as /clj-native so bb.edn's
# :local/root "../clj-native" resolves from /build/. The symlink is a
# no-op when the vendor dir is absent.
RUN if [ -d /build/clj-native-vendor ]; then \
      ln -snf /build/clj-native-vendor /clj-native; \
    fi

RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command echo "Nix environment ready"

RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bb --version

# ============================================================
# BUILD STAGES
# ============================================================

FROM base AS wasm-build
ARG EXTRA_BB_ARGS=""
ARG EXTRA_NIX_FLAGS=""
# The bb task that produces the wasm artifacts.
ARG BUILD_WASM_TASK="build --wasm"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command sh -c "bb $BUILD_WASM_TASK $EXTRA_BB_ARGS"

FROM base AS native-build
ENV PATH=/nix/var/nix/profiles/default/bin:$PATH
ARG EXTRA_BB_ARGS=""
ARG EXTRA_NIX_FLAGS=""
ARG TARGET_PLATFORM=linux/amd64
# The bb task that produces the native artifacts. --target <platform> is
# appended. Nothing else is: a debug build is opt-in through
# EXTRA_BB_ARGS="--debug", because for some consumers --debug means a full
# AddressSanitizer build that is roughly 5x slower and must not be shipped.
ARG BUILD_NATIVE_TASK="build --native"
# Flake dev-shell outputs per cross target. The defaults are what
# clj-native's mkCrossShells helper exports; consumers get them by
# importing clj-native, and override these ARGs otherwise.
ARG NIX_SHELL_LINUX_AMD64=".#linuxAmd64Cross"
ARG NIX_SHELL_LINUX_AARCH64=".#linuxAarch64Cross"
ARG NIX_SHELL_WINDOWS_AMD64=".#windowsAmd64Cross"
ARG NIX_SHELL_WINDOWS_ARM64=".#windowsArm64Cross"
RUN if echo "$TARGET_PLATFORM" | grep -q "^linux/aarch64"; then \
      NIX_SHELL="$NIX_SHELL_LINUX_AARCH64"; \
    elif echo "$TARGET_PLATFORM" | grep -q "^linux/amd64"; then \
      NIX_SHELL="$NIX_SHELL_LINUX_AMD64"; \
    elif echo "$TARGET_PLATFORM" | grep -q "^windows/amd64"; then \
      NIX_SHELL="$NIX_SHELL_WINDOWS_AMD64"; \
    elif echo "$TARGET_PLATFORM" | grep -q "^windows/arm64"; then \
      NIX_SHELL="$NIX_SHELL_WINDOWS_ARM64"; \
    else \
      NIX_SHELL="$NIX_SHELL_LINUX_AMD64"; \
    fi && \
    echo "Using nix shell: $NIX_SHELL for platform: $TARGET_PLATFORM" && \
    TARGET_CLEAN=$(echo "$TARGET_PLATFORM" | tr / -) && \
    nix develop $NIX_SHELL $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command sh -c "NIX_BUILD_TOP=1 bb $BUILD_NATIVE_TASK --target $TARGET_CLEAN $EXTRA_BB_ARGS"

# Convenience stage: build everything and aggregate artifacts under /build.
FROM base AS build-all
COPY --from=wasm-build /build/resources ./resources/
COPY --from=wasm-build /build/src ./src/
COPY --from=native-build /build/resources ./resources/

# ============================================================
# TEST STAGES (only work if the consumer's bb.edn defines these tasks)
# ============================================================

FROM native-build AS test-ffi
ARG EXTRA_NIX_FLAGS=""
ARG TEST_FFI_TASK="test:ffi"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bb $TEST_FFI_TASK

FROM build-all AS test-graal
ARG EXTRA_NIX_FLAGS=""
ARG TEST_GRAAL_TASK="test:graal"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bb $TEST_GRAAL_TASK

FROM wasm-build AS test-node
ARG EXTRA_NIX_FLAGS=""
ARG TEST_NODE_TASK="test:node"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bb $TEST_NODE_TASK

FROM wasm-build AS test-playwright
ARG EXTRA_NIX_FLAGS=""
ARG TEST_PLAYWRIGHT_TASK="test:playwright"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bash -c "cd test/browser && npm install && npx playwright install --with-deps"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bb $TEST_PLAYWRIGHT_TASK

FROM build-all AS test-all
ARG EXTRA_NIX_FLAGS=""
ARG TEST_FFI_TASK="test:ffi"
ARG TEST_GRAAL_TASK="test:graal"
ARG TEST_NODE_TASK="test:node"
RUN nix develop $EXTRA_NIX_FLAGS --accept-flake-config --option filter-syscalls false \
    --command bash -c "\
        echo '=== Running FFI Tests ===' && bb $TEST_FFI_TASK && \
        echo '=== Running Graal Tests ===' && bb $TEST_GRAAL_TASK && \
        echo '=== Running Node Tests ===' && bb $TEST_NODE_TASK && \
        echo '=== All tests completed ==='"

# ============================================================
# DEVELOPMENT ENVIRONMENT
# ============================================================

FROM base AS dev
RUN nix-env -iA \
    nixpkgs.vim \
    nixpkgs.neovim \
    nixpkgs.tmux \
    nixpkgs.htop \
    nixpkgs.ripgrep \
    nixpkgs.fd \
    nixpkgs.bat \
    nixpkgs.jq \
    nixpkgs.tree \
    --option filter-syscalls false

WORKDIR /workspace
RUN git config --global --add safe.directory /workspace

RUN printf '%s\n' \
'echo "clj-native development environment"' \
'echo "Available bb tasks: run \`bb tasks\` to see the list"' \
'echo ""' \
'alias ll="ls -la"' \
'export PS1="[dev] \w $ "' >> ~/.bashrc
RUN echo 'source ~/.bashrc' > ~/.bash_profile

ENTRYPOINT ["nix", "develop", "--accept-flake-config", "--option", "filter-syscalls", "false", "--command"]
CMD ["bash", "--login"]

# ============================================================
# EXPORT STAGE (writes a generic artifact tree to ./)
# ============================================================

FROM scratch AS export
COPY --from=wasm-build /build/resources ./resources/
COPY --from=wasm-build /build/src ./src/
COPY --from=native-build /build/resources ./resources/

# ============================================================
# DEFAULT: build everything
# ============================================================
FROM build-all
