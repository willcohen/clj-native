{:paths ["src/clj" "src/cljc" "src/bb" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ;; Optional: ~88MB of jars that only the JVM FFI (dtype-next) and the
        ;; GraalVM-WASM fallback need. A consumer of either declares them.
        cnuernber/dtype-next {:mvn/version "11.026" :optional true}
        org.graalvm.js/js-language {:mvn/version "25.3.4.1" :optional true}
        org.graalvm.polyglot/polyglot {:mvn/version "25.3.4.1" :optional true}
        org.graalvm.wasm/wasm-language {:mvn/version "25.3.4.1" :optional true}}
 :aliases
 {:test {:extra-paths ["test/clj" "test/cljc" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         ;; ffi-mem and callbacks tests use restricted Panama operations.
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner" "-d" "test/clj" "-d" "test/cljc"]}
  :nrepl {:extra-paths ["test/clj" "test/cljc"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts ["-m" "nrepl.cmdline" "--port" "7889"]}
  :build {:deps {io.github.clojure/tools.build
                 {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}
  ;; deps-deploy defaults :pom-file to ./pom.xml, which tools.build never
  ;; writes.
  :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
           :exec-fn deps-deploy.deps-deploy/deploy
           :exec-args {:installer :remote
                       :sign-releases? false
                       :pom-file "target/classes/META-INF/maven/net.willcohen/native/pom.xml"
                       :artifact "target/native-0.0.3.jar"}}}}
