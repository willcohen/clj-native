{:paths ["src/bb" "src/clj" "src/cljc" "resources"]
 :deps {org.babashka/http-client {:mvn/version "0.4.25"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str]
             [clojure.java.shell :as jshell]
             [net.willcohen.native.build :as nb])

  ;; build.clj is the one place that declares the release version. A task that
  ;; names the version reads it from here, so a bump touches build.clj alone.
  ;; The static files that cannot compute it (deps.edn, package.json, README)
  ;; are pinned against build.clj by version-test instead.
  ;; re-pattern, not a #"" literal: bb.edn is read as EDN, which has no regex.
  :init (def project-version
          (or (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)")
                               (slurp "build.clj")))
              (throw (ex-info "build.clj carries no (def version \"...\")" {}))))

  lint:deps
  {:doc "Index the Clojure classpath into .clj-kondo/.cache so clj-kondo resolves dependency vars. Run again after a dependency version bump."
   ;; clj-kondo resolves vars from other libraries only through this cache.
   ;; .clj-kondo/.cache is in .gitignore, so a new clone has no cache, and
   ;; clj-kondo then reports library vars as "Unresolved var", or misses a
   ;; finding that depends on knowing a var's type.
   ;;
   ;; --dependencies is the flag that fills the cache. "--copy-configs
   ;; --skip-lint" only copies the exported configs. It skips the analysis,
   ;; so it leaves the cache empty.
   ;;
   ;; The cache lives in .clj-kondo/.cache-cli, not the default
   ;; .clj-kondo/.cache, because clojure-lsp writes the default one from its
   ;; own index and can replace a namespace entry with a hook stub that hides
   ;; the real vars.
   ;; Two classpaths: the project's, and the :build alias's (tools.build),
   ;; which -A:build REPLACES the project deps with. Indexing both lets the
   ;; widened lint scope resolve clojure.tools.build.api in root build.clj.
   :task (let [cp (str/trim (:out (jshell/sh "clojure" "-Spath")))
               build-cp (str/trim (:out (jshell/sh "clojure" "-Spath" "-A:build")))]
           (shell "clj-kondo" "--lint" (str cp ":" build-cp)
                  "--dependencies" "--parallel"
                  "--cache-dir" ".clj-kondo/.cache-cli"))}

  lint:js
  {:doc "Run eslint over the hand-written .mjs (7 runtime modules + the test
fixtures + eslint.config.mjs itself). The six compiled squint outputs and
the compiled test mirrors are ignored in eslint.config.mjs."
   :depends [npm:install]
   :task (shell "npx" "eslint" ".")}

  lint
  {:doc "Run eslint via lint:js, then clj-kondo on every tracked Clojure
surface: src, test, the root build.clj, bb.edn (kondo lints task bodies),
deps.edn, and resources (the shipped kondo hook). eslint goes first because
lint:js is a :depends, and a :depends runs before the task body."
   :depends [lint:js]
   :task (do (when-not (fs/exists? ".clj-kondo/.cache-cli")
               (println "No clj-kondo dependency cache. Indexing the classpath once (see lint:deps).")
               (run 'lint:deps))
             (shell "clj-kondo" "--lint" "src" "test" "build.clj" "bb.edn" "deps.edn" "resources"
                    "--cache-dir" ".clj-kondo/.cache-cli"))}

  test:clj
  {:doc "Run Clojure tests via the cognitect test-runner.
Depends on squint:test-runner because test_runner_test.clj drives
test/fixtures/exit-code-probe.mjs through the compiled test_runner.mjs to pin
its exit codes. That pin has to run on the JVM: a CLJS suite checking the
runner would be false-greened by the very break it is looking for."
   :depends [squint:test-runner]
   :task (shell "clojure" "-M:test")}

  test:bb
  {:doc "Run the tests of the babashka build helpers in test/bb."
   :extra-paths ["test/bb"]
   :requires ([clojure.test :as t]
              [net.willcohen.native.build-test])
   :task (let [{:keys [fail error]} (t/run-tests 'net.willcohen.native.build-test)]
           (when (pos? (+ fail error)) (System/exit 1)))}

  test
  {:doc "Run every lane: test:clj, test:cljs and test:bb."
   :depends [test:clj test:cljs test:bb]}

  npm:install
  {:doc "Install clj-native's npm dependencies. package.json pins the squint-cljs version."
   :task (shell "npm" "install")}

  squint:pool
  {:doc "Compile src/cljc/net/willcohen/native/pool.cljc -> pool.mjs alongside it.
The compiled output is shipped via package.json `exports[\"./pool\"]` so that
consumer libraries can import it as `[\"ffi-wasm/pool\" :as pool]`
without a per-consumer squint build step."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "pool.cljc")}

  squint:workload-pool
  {:doc "Compile src/cljc/net/willcohen/native/workload_pool.cljc -> workload_pool.mjs.
Shipped via package.json exports[\"./workload-pool\"]. CLJS side of the
workload-class executor pool registry (mixed/io/compute). Consumer
libraries import as [\"ffi-wasm/workload-pool\" :as wp]."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "workload_pool.cljc")}

  squint:platform-state
  {:doc "Compile src/cljc/net/willcohen/native/platform_state.cljc -> platform_state.mjs.
Shipped via package.json exports[\"./platform-state\"]."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "platform_state.cljc")}

  squint:dispatch
  {:doc "Compile src/cljc/net/willcohen/native/dispatch.cljc -> dispatch.mjs.
Shipped via package.json exports[\"./dispatch\"]. Generic per-fn dispatch
shell consumer libraries call to route ccalls through the worker pool
(CLJS) or GraalVM (JVM)."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "dispatch.cljc")}

  squint:macros
  {:doc "Compile src/cljc/net/willcohen/native/macros.cljc -> macros.mjs.
Macros are expanded at squint compile time; the .mjs is needed only
because consumer bundlers (esbuild) emit runtime imports for plain
:require forms regardless of macro-vs-runtime usage. The .mjs body
is dead code in the consumer bundle but must exist for esbuild to
resolve the import. macros.cljc is the ONE .cljc shipped in the npm
tarball (package.json `files`): squint reads it at consumer compile
time to expand the macros. Every other module ships only its built
.mjs -- squint resolves those namespaces to the .mjs, so their .cljc
stay JVM-side (the Clojars jar) and out of the npm package."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "macros.cljc")}

  squint:test-runner
  {:doc "Compile src/cljc/net/willcohen/native/test_runner.cljc -> test_runner.mjs.
Shipped via package.json exports[\"./test-runner\"]. Cljs.test runner
footer helper for consumer libraries -- always exits explicitly so the
worker pool doesn't keep Node alive past the test summary."
   :depends [npm:install]
   :task (nb/squint-compile! "src/cljc/net/willcohen/native" "test_runner.cljc")}

  check:exports
  {:doc "Verify build.clj's module inventory (npm-package-name,
shipped-module-files, the export subpath rule) matches package.json's
name, files and exports maps. Consumer staging tasks build their copy
lists and specifier rewrites from the inventory, so drift here is what
makes them rot. Fails build:js, and through prepack every npm pack."
   :task (nb/check-exports-sync!)}

  build:js
  {:doc "Compile all CLJC modules clj-native ships as JS.
Add a future module to the :depends list below."
   :depends [check:exports
             squint:pool squint:workload-pool squint:platform-state
             squint:dispatch squint:macros squint:test-runner]}

  squint:test:pool
  {:doc "Compile test/cljs/net/willcohen/native/pool_test.cljc. cljs-only
cljs.test suite exercising pool.cljc's LibraryContext WeakRef/
FinalizationRegistry lifetime; self-imports ffi-wasm/pool + ffi-wasm/
test-runner. Runner needs `--expose-gc`; bb test:cljs sets that flag."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "pool_test.cljc")}

  squint:test:handler-runtime
  {:doc "Compile test/cljs/net/willcohen/native/handler_runtime_test.cljc.
cljs-only cljs.test suite for the handler runtime; self-imports
ffi-wasm/handler-runtime + ffi-wasm/test-runner. Lives under test/cljs
(squint-only) since its body is plain-JS interop the JVM runner can't read."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "handler_runtime_test.cljc")}

  squint:test:dispatch
  {:doc "Compile test/cljc/net/willcohen/native/dispatch_test.cljc.
Dual-runtime (clojure.test + cljs.test) coverage for dispatch.cljc's
cross-platform surface: argtype->ccall-type + the hook registry. The
cljs lane self-imports ffi-wasm/dispatch and ffi-wasm/test-runner via
node package self-resolution."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljc/net/willcohen/native" "dispatch_test.cljc")}

  squint:test:macros
  {:doc "Compile test/cljc/net/willcohen/native/macros_test.cljc.
Dual-runtime coverage for the surface-generation helpers. The two name
mappings decide the public name of every generated fn, so a divergence
between the lanes would rename part of a consumer's API on one platform
only; running the same bodies in both lanes is the point of this suite.
The cljs lane self-imports ffi-wasm/macros."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljc/net/willcohen/native" "macros_test.cljc")}

  squint:test:platform-state
  {:doc "Compile test/cljc/net/willcohen/native/platform_state_test.cljc.
Dual-runtime coverage for platform-state's pure predicates + force/impl
atom transitions. cljs lane self-imports ffi-wasm/platform-state."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljc/net/willcohen/native" "platform_state_test.cljc")}

  squint:test:http-bridge
  {:doc "Compile test/cljs/net/willcohen/native/http_bridge_test.cljc.
cljs-only cljs.test suite for the sync HTTP bridge (fetch worker over
SharedArrayBuffer + Atomics, XHR polyfill, decorator seam). Self-imports
ffi-wasm/http-bridge + ffi-wasm/test-runner; drives test/fixtures workers."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "http_bridge_test.cljc")}

  squint:test:handler-env
  {:doc "Compile test/cljs/net/willcohen/native/handler_env_test.cljc.
cljs-only cljs.test coverage for the environment classifier. Every branch
runs against a stand-in globals object, so the suite needs no browser."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "handler_env_test.cljc")}

  squint:test:handler-fs
  {:doc "Compile test/cljs/net/willcohen/native/handler_fs_test.cljc.
cljs-only cljs.test coverage for MEMFS staging against a recording stand-in
for module.FS, including the older emscripten mkdir shape."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "handler_fs_test.cljc")}

  squint:test:handler-heap
  {:doc "Compile test/cljs/net/willcohen/native/handler_heap_test.cljc.
cljs-only cljs.test coverage for the heap methods object and the plain ccall
method, against a stand-in module backed by one real ArrayBuffer."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "handler_heap_test.cljc")}

  squint:test:handler-paths
  {:doc "Compile test/cljs/net/willcohen/native/handler_paths_test.cljc.
cljs-only cljs.test coverage for asset probing and emscripten-module loading
against the real filesystem, so a wrong number of levels has to fail."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "handler_paths_test.cljc")}

  squint:test:workload-pool
  {:doc "Compile test/cljs/net/willcohen/native/workload_pool_test.cljc.
cljs-only cljs.test coverage for workload-pool's CLJS registry surface
(init/register-handler!/current-context/shutdown-pool!). Self-imports
ffi-wasm/workload-pool + ffi-wasm/test-runner."
   :depends [npm:install]
   :task (nb/squint-compile! "test/cljs/net/willcohen/native" "workload_pool_test.cljc")}

  build:js:test
  {:doc "Compile all cljs.test mirrors. Pre-flight for `bb test:cljs`."
   :depends [squint:test:pool squint:test:handler-runtime squint:test:dispatch
             squint:test:macros squint:test:platform-state squint:test:http-bridge
             squint:test:workload-pool squint:test:handler-env
             squint:test:handler-fs squint:test:handler-heap
             squint:test:handler-paths]}

  test:cljs
  {:doc "Run the squint cljs.test suites on Node. Each test file registers
its deftests at top level and calls cljs.test/run-tests on import, so the
node invocation just imports it. pool_test runs under --expose-gc so its
WeakRef sweep checks can drive the FinalizationRegistry. Eleven suites run:
handler_runtime, pool, dispatch, macros, platform_state, http_bridge,
workload_pool, handler_env, handler_fs, handler_heap, handler_paths."
   :depends [build:js build:js:test]
   :task (do
           (shell "node" "test/cljs/net/willcohen/native/handler_runtime_test.mjs")
           (shell "node" "--expose-gc" "test/cljs/net/willcohen/native/pool_test.mjs")
           (shell "node" "test/cljc/net/willcohen/native/dispatch_test.mjs")
           (shell "node" "test/cljc/net/willcohen/native/macros_test.mjs")
           (shell "node" "test/cljc/net/willcohen/native/platform_state_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/http_bridge_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/workload_pool_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/handler_env_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/handler_fs_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/handler_heap_test.mjs")
           (shell "node" "test/cljs/net/willcohen/native/handler_paths_test.mjs"))}

  jar
  {:doc "Build the JVM jar (net.willcohen/native) via tools.build."
   :task (do
           (println "Building jar...")
           (shell "clojure" "-T:build" "jar")
           (println (str "Jar built: target/native-" project-version ".jar")))}

  install
  {:doc "Install the jar to the local ~/.m2 as net.willcohen/native, at the
version build.clj declares. Lets a consumer test against :mvn/version before
anything is published. Note that a local install shadows the real release
once it ships, so a green build here is not proof that Clojars resolves."
   :depends [jar]
   :task (do
           (println "Installing to local .m2...")
           (shell "clojure" "-X:deploy" ":installer" ":local")
           (println (str "Installed net.willcohen/native " project-version
                         " to ~/.m2.")))}

  deploy:clojars
  {:doc "Deploy the jar to Clojars as net.willcohen/native. Requires
CLOJARS_USERNAME / CLOJARS_PASSWORD (a Clojars deploy token) in the env."
   :depends [jar]
   :task (do
           (println "Deploying to Clojars...")
           (shell "clojure" "-X:deploy")
           (println "Deployed to Clojars."))}

  deploy:npm
  {:doc "Publish the npm package (ffi-wasm). package.json's prepack script runs
bb build:js first, so the shipped .mjs are always freshly compiled from their
.cljc."
   :task (do
           (println "Publishing to npm...")
           (shell "npm" "publish")
           (println "Published to npm."))}

  gen-handler
  {:doc "Smoke check: invoke gen-handler-source on a synthetic fndefs map and
print the emitted JS to stdout. Real consumer libraries call
net.willcohen.native.gen-handler/write-handler! directly via :local/root."
   :requires ([net.willcohen.native.gen-handler :as g])
   :task (let [fndefs   {:mylib_create
                         {:rettype :pointer
                          :argtypes [[:context :pointer] [:definition :string]]}
                         :mylib_destroy
                         {:rettype :void
                          :argtypes [[:handle :pointer]]
                          :destroy? true}
                         :mylib_context_destroy
                         {:rettype :void
                          :argtypes [[:context :pointer]]
                          :destroy? true}}
               overrides {:overrides-import-path "./demo-overrides.mjs"
                          :runtime-import-path "ffi-wasm/handler-runtime"
                          :exposed-methods [:ccall :malloc :free :shutdown]
                          :busy-methods [:ccall :malloc]
                          :destroy-methods [:free :shutdown]}]
           (println (g/gen-handler-source fndefs overrides)))}}}
